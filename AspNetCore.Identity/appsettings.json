{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Postgres": {
        "DbConnection": "Host=localhost;Port=5432;Database=AspNetCore.Identity;Username=postgres;Password=postgres"
    },
    "Serilog": {
        "Using": ["Serilog.Sinks.Console"],
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [Source: {SourceContext}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Error",
                "System": "Error"
            }
        },
        "Filter": [
            {
                "Name": "ByExcluding"
            }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
    },
    "Jwt": {
        "Audience": "identity",
        "Issuer": "User",
        "Signingkey": "NT0wxMAKSD4u5UpEvGXxcpx+iKQszd7KwRHG9bJcrNc=",
        "ValidateIssuerSigningKey": true
    }
}
